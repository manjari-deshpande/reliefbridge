<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>ReliefBridge Leads Assignment</fullName>
        <active>true</active>
        <ruleEntry>
            <assignedTo>Senior_Coordinators</assignedTo>
            <assignedToType>Queue</assignedToType>
            <booleanFilter>1 AND (2 OR 3)</booleanFilter>
            <criteriaItems>
                <field>Lead.Status</field>
                <operation>equals</operation>
                <value>Open - Not Contacted</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.Organization_Type__c</field>
                <operation>equals</operation>
                <value>Government_Agency</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.Estimated_Contribution_Range__c</field>
                <operation>equals</operation>
                <value>100K_Plus</value>
            </criteriaItems>
            <template>ReliefBridge_Email_Templates/ReliefBridge_Lead_Assignment_Classic</template>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>General_Partnership_Pool</assignedTo>
            <assignedToType>Queue</assignedToType>
            <booleanFilter>1</booleanFilter>
            <criteriaItems>
                <field>Lead.Status</field>
                <operation>equals</operation>
                <value>Open - Not Contacted</value>
            </criteriaItems>
            <template>ReliefBridge_Email_Templates/ReliefBridge_Lead_Assignment_Classic</template>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
